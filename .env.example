# Copy to .env.local for local development. Never commit real credentials.
# For production, configure these in your hosting provider's secret manager.

# PostgreSQL is required for production, shared/team inboxes, live WhatsApp,
# account administration, durable webhooks, and multi-number failover.
DATABASE_URL=postgresql://crm_user:replace-this-password@localhost:5432/whatsapp_crm
CRM_WORKSPACE_ID=default-workspace
CRM_WORKSPACE_NAME=WhatsApp CRM
# Keep this stable and back it up securely. It must be at least 32 random
# characters in production; it encrypts Meta credentials and archived media.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Required before public production owner setup. Keep this separate from
# SESSION_SECRET and share it only with the person setting up the first owner.
OWNER_SETUP_SECRET=replace-with-a-long-one-time-setup-secret

# Meta WhatsApp Cloud API / Embedded Signup. Embedded Signup requires a
# configured Meta app and approved permissions; see README.md.
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_API_VERSION=v26.0
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-random-webhook-verification-token
# Optional system-user token for already-onboarded WABAs not linked via signup.
META_ACCESS_TOKEN=

# Transactional email for password reset, team invitations, security notices,
# and optional administrator email alerts.
APP_BASE_URL=http://localhost:3000
RESEND_API_KEY=
PASSWORD_RESET_FROM=

# Optional bearer secrets for externally scheduled jobs. Use separate random
# values for each endpoint and invoke only over HTTPS in production.
WEBHOOK_RECOVERY_SECRET=
RETENTION_CLEANUP_SECRET=
ALERT_EMAIL_SECRET=

# Optional ClamAV daemon for inbound and outbound attachment scanning.
# Attachments are unavailable for download/send until scanning confirms clean.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Optional local development and migration controls.
CRM_STORE_PATH=
# Set to true only to copy real records from the local JSON store into an empty
# PostgreSQL workspace. Built-in demo customers and numbers are never imported.
CRM_IMPORT_LOCAL_DATA=false

